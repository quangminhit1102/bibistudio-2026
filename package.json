{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "validate:catalogue": "node scripts/catalogue-images.mjs",
    "localize:catalogue": "node scripts/catalogue-images.mjs --localize",
    "test:catalogue": "node --test scripts/catalogue-images.test.mjs scripts/catalogue-image-url.test.mjs",
    "prebuild": "npm run validate:catalogue && node scripts/prepare-tinymce.mjs",
    "prebuild:dev": "npm run validate:catalogue && node scripts/prepare-tinymce.mjs",
    "prebuild:cpanel": "npm run validate:catalogue && node scripts/prepare-tinymce.mjs",
    "prebuild:cpanel:temp": "npm run validate:catalogue && node scripts/prepare-tinymce.mjs",
    "postinstall": "node scripts/install-backend.mjs && node scripts/prepare-tinymce.mjs",
    "dev": "node scripts/prepare-tinymce.mjs && node scripts/analytics-catalogue.mjs && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev.mjs",
    "db:setup:local": "node backend/node_modules/typescript/bin/tsc -p backend/tsconfig.build.json && node scripts/local-database.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:cpanel": "vite build --config vite.cpanel.config.ts",
    "build:cpanel:temp": "vite build --config vite.cpanel.config.ts --mode cpanel-temp",
    "deploy:cpanel:temp": "node scripts/cpanel-deploy-artifacts.mjs --mode temp",
    "deploy:cpanel:temp:push": "node scripts/cpanel-deploy-artifacts.mjs --mode temp --push",
    "deploy:cpanel:prod": "node scripts/cpanel-deploy-artifacts.mjs --mode prod",
    "deploy:cpanel:prod:push": "node scripts/cpanel-deploy-artifacts.mjs --mode prod --push",
    "test:deploy": "node --test scripts/cpanel-deploy-artifacts.test.mjs",
    "test:admin": "vitest run --config vitest.admin.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "1.168.42",
    "@tinymce/tinymce-react": "6.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tinymce": "8.10.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.25.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.7",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.64.1",
    "prettier": "^3.7.3",
    "tar": "^7.5.22",
    "tinymce-i18n": "26.11.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
