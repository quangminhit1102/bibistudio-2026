# API demo runs with these defaults; no secret needed.
FRONTEND_PORT=5173
BACKEND_PORT=3001
INSPECTOR_PORT=9230

# Private backend database configuration. Put real values in ignored .env.local.
# Runtime user: DML only. Supply migration/backup credentials separately to deployment tooling.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_LIMIT=5
# First explicit bootstrap only; never overwrite an existing account during deployment.
MASTER_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
