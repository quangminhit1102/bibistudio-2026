# Dedicated local setup: npm run db:setup:local (Docker Desktop + Node24).
# Generated ignored files: .env.local for runtime and .env.migration.local for explicit migrations/seed.
FRONTEND_PORT=5173
BACKEND_PORT=3001
INSPECTOR_PORT=9230

# Private backend database configuration. Put real values in ignored .env.local.
# Runtime user: DML only. Supply migration/backup credentials separately to deployment tooling.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_LIMIT=5
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=bibistudio-api
AUTH_JWT_AUDIENCE=bibistudio-admin
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
ANALYTICS_ID_SECRET=
RELEASE_PROBE_SECRET=
# Leave empty until the actual hosting reverse proxy has been measured.
TRUSTED_PROXY_CIDRS=
# Production only: absolute private path outside webroot/releases; never use a VITE_ prefix.
BIBI_PRIVATE_ENV_FILE=
# First explicit bootstrap only; put these in .env.migration.local, not frontend env.
MASTER_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# Host maintenance only; never copy into a frontend-prefixed variable.
RELEASE_PROBE_PASSWORD=
BIBI_MAINTENANCE_ENV_FILE=
DB_VERIFY_NAME=
DB_BACKUP_FLAVOR=
DB_DUMP_BIN=
DB_CLIENT_BIN=
# cPanel15minute log job: configured once by deployment, never exposed to frontend.
# Local db:setup:local generates synthetic current/archive paths automatically.
ACCESS_LOG_ARCHIVE_DIR=
ACCESS_LOG_DOMAIN_ALIAS=
ACCESS_LOG_WORK_DIR=
ACCESS_LOG_CURRENT_DIR=
