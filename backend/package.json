{
  "name": "bibistudio-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=../.env.migration.local dist/db/cli.js migrate",
    "db:seed": "node --env-file-if-exists=../.env.migration.local dist/db/cli.js seed",
    "db:status": "node --env-file-if-exists=../.env.local dist/db/cli.js status",
    "analytics:cleanup": "node --env-file-if-exists=../.env.local dist/db/cli.js analytics:cleanup",
    "auth:cleanup": "node --env-file-if-exists=../.env.local dist/db/cli.js auth:cleanup",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/server.js",
    "dev": "tsx watch --inspect=127.0.0.1:9230 src/server.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "express": "^5.1.0",
    "helmet": "8.3.0",
    "ipaddr.js": "2.5.0",
    "jpeg-js": "0.4.4",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.24.6",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
